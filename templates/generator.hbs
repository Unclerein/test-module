<form class="dhnpc-form">

  <div class="dhnpc-header">
    <i class="fas fa-dragon"></i>
    <span>Générateur de PNJ</span>
  </div>

  <div class="form-group">
    <label for="dhnpc-sexe">Sexe</label>
    <select id="dhnpc-sexe" name="sexe">
      <option value="aleatoire">— Aléatoire —</option>
      <option value="m">Masculin</option>
      <option value="f">Féminin</option>
    </select>
  </div>

  <div class="form-group">
    <label for="dhnpc-race">Race</label>
    <select id="dhnpc-race" name="race">
      <option value="aleatoire">— Aléatoire —</option>
      <option value="humain">Humain(e)</option>
      <option value="nain">Nain(e)</option>
      <option value="elfe">Elfe</option>
      <option value="drakeide">Drakeide</option>
      <option value="fee">Fée (hybride insecte)</option>
      <option value="animorphe">Animorphe (tête animale)</option>
      <option value="gueule_libre">Gueule Libre (animal parlant)</option>
    </select>
  </div>

  <button type="button" id="dhnpc-generate">
    <i class="fas fa-dice"></i> Générer et ouvrir le journal
  </button>

</form>
